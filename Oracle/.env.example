# プロジェクトルートで一括管理。Docker Compose 経由で各コンテナへ注入する（design.md セクション8）。
# コピー: cp .env.example .env
#
# バックエンド・フロントをホストで単体実行する場合は、それぞれ backend/.env と frontend/.env を
# backend/.env.example / frontend/.env.example からコピーして作成してください。

# PostgreSQL（backend と db で共通）
POSTGRES_USER=doll_roulette
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=doll_roulette

# DB 接続（backend 用。docker-compose ではサービス名 db で疎通）
DB_HOST=db
DB_PORT=5432

# バックエンド（フロント・スマホから参照するURL。WSL2の場合は 0.0.0.0 で待機）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

# フロントエンド（API のベース URL）
# PC のみ: http://localhost:3000
# スマホ接続時: http://PCのIPアドレス:3000（例: http://192.168.1.100:3000）
# 本番: https://あなたのドメイン または http://パブリックIP
VITE_API_BASE_URL=http://localhost:3000

# 本番のみ（パブリック公開時）: 許可する CORS オリジン（VITE_API_BASE_URL と揃える）
# ALLOWED_ORIGIN=https://あなたのドメイン

# 入室用パスワード（設定すると最初にパスワード入力画面が表示される。未設定なら認証なし）
# APP_PASSWORD=あなたのパスワード

# 画像ストレージ（未設定または local = VM の uploads。oci = OCI Object Storage）
# STORAGE_TYPE=local
# Oracle Cloud で Object Storage を使う場合:
# STORAGE_TYPE=oci
# OCI_OS_NAMESPACE=あなたのテナントのネームスペース
# OCI_OS_BUCKET=画像用バケット名
# OCI_OS_REGION=ap-tokyo-1
# OCI_OS_ACCESS_KEY_ID=Customer Secret Key の Access Key
# OCI_OS_SECRET_ACCESS_KEY=Customer Secret Key の Secret Key
