# バックエンド単体実行時用（ホストで npm run dev する場合）
# Docker Compose 利用時はルートの .env が注入されるため、このファイルは不要です。
# コピー: cp .env.example .env

NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

# DB 接続（Docker 内の db ではなくローカルの Postgres に繋ぐ場合は host を変更）
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=doll_roulette
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=doll_roulette
